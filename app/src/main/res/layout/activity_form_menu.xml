<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Toolbar Atas -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarFormMenu"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:title="Tambah Menu &amp; Multi-Channel"
        app:titleTextColor="@color/white"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: Informasi Dasar Menu -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/white"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INFORMASI DASAR MENU"
                        android:textColor="#334155"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Nama Menu -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nama Menu *"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etFormNama"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_search_rounded"
                        android:hint="Contoh: Martabak Sosis Spesial"
                        android:textSize="13sp"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp" />

                    <!-- SKU -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kode SKU *"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etFormSku"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_search_rounded"
                        android:hint="Contoh: MRT-008"
                        android:textSize="13sp"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true"
                        android:fontFamily="monospace"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp" />

                    <!-- Kategori (Spinner) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kategori Menu *"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spFormKategori"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_search_rounded"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp" />

                    <!-- Deskripsi -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Deskripsi Menu"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etFormDeskripsi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:background="@drawable/bg_search_rounded"
                        android:hint="Deskripsi rasa, porsi, dan kelezatan..."
                        android:textSize="13sp"
                        android:padding="12dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp" />

                    <!-- HPP -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Harga Pokok Penjualan (HPP Bahan)"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etFormHpp"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_search_rounded"
                        android:hint="15000"
                        android:inputType="number"
                        android:textSize="13sp"
                        android:paddingHorizontal="14dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp" />

                    <!-- Checkbox Ketersediaan -->
                    <CheckBox
                        android:id="@+id/cbFormKetersediaan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Menu Tersedia untuk Dijual (Aktif)"
                        android:textColor="#0F172A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:checked="true" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Foto Menu (Kamera / Galeri) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FOTO MENU (OPSIONAL)"
                        android:textColor="#334155"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/imgFormPreview"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/logo_jenggirat_transparent"
                            android:background="#FFF3E0"
                            android:padding="4dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnFormKamera"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:text="Kamera"
                                android:textColor="@color/primary"
                                android:textSize="11sp"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                app:strokeColor="@color/primary"
                                app:strokeWidth="1dp"
                                app:cornerRadius="8dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:layout_marginEnd="4dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnFormGaleri"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:text="Galeri"
                                android:textColor="@color/primary"
                                android:textSize="11sp"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                app:strokeColor="@color/primary"
                                app:strokeWidth="1dp"
                                app:cornerRadius="8dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:layout_marginStart="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Pengaturan Harga Multi-Channel (Arsitektur PTT) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="PENGATURAN HARGA MULTI-CHANNEL"
                            android:textColor="#334155"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <!-- Tombol Bantuan Hitung Markup Ojol (+20%) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAutoMarkupOjol"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="⚡ Auto Ojol (+20%)"
                            android:textColor="#92400E"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:backgroundTint="#FEF3C7"
                            app:cornerRadius="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />
                    </LinearLayout>

                    <!-- 1. Offline Kasir -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Harga Kasir Offline (Dine-In / Takeaway) *"
                        android:textColor="#B45309"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etFormHargaOffline"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_search_rounded"
                        android:hint="20000"
                        android:inputType="number"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="14dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp" />

                    <!-- 2. Web Pelanggan -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Harga Website Pelanggan (Self-Order)"
                        android:textColor="#1D4ED8"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etFormHargaWeb"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_search_rounded"
                        android:hint="20000"
                        android:inputType="number"
                        android:textSize="13sp"
                        android:paddingHorizontal="14dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp" />

                    <!-- 3. GoFood -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3. Harga GoFood"
                        android:textColor="#047857"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etFormHargaGofood"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_search_rounded"
                        android:hint="24000"
                        android:inputType="number"
                        android:textSize="13sp"
                        android:paddingHorizontal="14dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp" />

                    <!-- 4. GrabFood -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4. Harga GrabFood"
                        android:textColor="#15803D"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etFormHargaGrabfood"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_search_rounded"
                        android:hint="24000"
                        android:inputType="number"
                        android:textSize="13sp"
                        android:paddingHorizontal="14dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp" />

                    <!-- 5. ShopeeFood -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5. Harga ShopeeFood"
                        android:textColor="#C2410C"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etFormHargaShopeefood"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_search_rounded"
                        android:hint="23000"
                        android:inputType="number"
                        android:textSize="13sp"
                        android:paddingHorizontal="14dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tombol Simpan -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimpanMenuForm"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Simpan Menu &amp; Multi-Channel"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary"
                app:cornerRadius="12dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
