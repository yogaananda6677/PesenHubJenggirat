<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:padding="12dp"
    android:layout_marginBottom="6dp">

    <!-- Header Item: ID Pesanan & Waktu Selesai -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txItemOrderId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="#ORD-20261008-01"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txItemWaktu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08/10/2026 21:00"
            android:textSize="11sp"
            android:textColor="#757575" />
    </LinearLayout>

    <!-- Nama Pelanggan -->
    <TextView
        android:id="@+id/txItemPelanggan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pelanggan: Budi (0812345678)"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginTop="2dp" />

    <!-- Detail Item Menu -->
    <TextView
        android:id="@+id/txItemMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Martabak Telur Spesial (Extra Keju)"
        android:textSize="12sp"
        android:textColor="#424242"
        android:layout_marginTop="2dp" />

    <!-- Footer: Metode Bayar & Total Bayar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/txItemMetode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pembayaran: Tunai"
            android:textSize="12sp"
            android:textColor="#616161" />

        <TextView
            android:id="@+id/txItemTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 40.000"
            android:textColor="@android:color/holo_green_dark"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
