<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card_menu"
    android:padding="12dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:gravity="center_vertical">

    <!-- Thumbnail Foto / Icon Menu -->
    <androidx.cardview.widget.CardView
        android:layout_width="68dp"
        android:layout_height="68dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFF3E0">

        <ImageView
            android:id="@+id/imgMenuPos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:src="@drawable/logo_jenggirat_transparent"
            android:contentDescription="Foto Menu" />
    </androidx.cardview.widget.CardView>

    <!-- Info Menu (Tag, Nama, Deskripsi, Harga) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <!-- Kategori Tag Pill -->
        <TextView
            android:id="@+id/tvTagKategori"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_pill"
            android:text="Martabak Telur"
            android:textColor="#495057"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_marginBottom="4dp" />

        <!-- Nama Menu -->
        <TextView
            android:id="@+id/tvNamaMenuPos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Martabak Sosis/Jamur Biasa"
            android:textColor="#1E232A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Deskripsi Menu -->
        <TextView
            android:id="@+id/tvDeskripsiMenuPos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kulit renyah gurih dengan isian spesial"
            android:textColor="#757575"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <!-- Harga Menu -->
        <TextView
            android:id="@+id/tvHargaMenuPos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 20.000"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Tombol Pilih -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPilihMenuPos"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:text="Pilih"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/primary"
        app:cornerRadius="10dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingHorizontal="16dp" />

</LinearLayout>
