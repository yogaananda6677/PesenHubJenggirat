<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_minimal"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="#D0D5DD" />

    <!-- Header Dialog: Judul Menu, Harga Dasar, dan Tombol Tutup -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/btnSheetTutup"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSheetNamaMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Martabak Sosis/Jamur Biasa"
                android:textColor="#1E232A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSheetHargaDasar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Harga Dasar: Rp 20.000"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSheetTutup"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:src="@drawable/ic_close"
            android:contentDescription="Tutup" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginVertical="6dp" />

    <!-- Scrollable Content Toppings & Options -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="360dp"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Extra Isian / Topping"
                android:textColor="#1E232A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp" />

            <!-- Row 1: Keju Mozzarella -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keju Mozzarella"
                        android:textColor="#212529"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Rp 15.000"
                        android:textColor="#757575"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btnMinusMozzarella"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:src="@drawable/ic_remove"
                        android:contentDescription="Kurang" />

                    <TextView
                        android:id="@+id/tvQtyMozzarella"
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#212529"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnPlusMozzarella"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:src="@drawable/ic_add"
                        android:contentDescription="Tambah" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Row 2: Daging Sapi -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daging Sapi"
                        android:textColor="#212529"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Rp 7.000"
                        android:textColor="#757575"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btnMinusSapi"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:src="@drawable/ic_remove"
                        android:contentDescription="Kurang" />

                    <TextView
                        android:id="@+id/tvQtySapi"
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#212529"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnPlusSapi"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:src="@drawable/ic_add"
                        android:contentDescription="Tambah" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Row 3: Daging Ayam -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daging Ayam"
                        android:textColor="#212529"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Rp 5.000"
                        android:textColor="#757575"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btnMinusAyam"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:src="@drawable/ic_remove"
                        android:contentDescription="Kurang" />

                    <TextView
                        android:id="@+id/tvQtyAyam"
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#212529"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnPlusAyam"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:src="@drawable/ic_add"
                        android:contentDescription="Tambah" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Row 4: Jamur -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jamur Tiram"
                        android:textColor="#212529"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Rp 5.000"
                        android:textColor="#757575"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btnMinusJamur"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:src="@drawable/ic_remove"
                        android:contentDescription="Kurang" />

                    <TextView
                        android:id="@+id/tvQtyJamur"
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#212529"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnPlusJamur"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:src="@drawable/ic_add"
                        android:contentDescription="Tambah" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Row 5: Sosis -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sosis Sapi"
                        android:textColor="#212529"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Rp 5.000"
                        android:textColor="#757575"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btnMinusSosis"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:src="@drawable/ic_remove"
                        android:contentDescription="Kurang" />

                    <TextView
                        android:id="@+id/tvQtySosis"
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#212529"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnPlusSosis"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:src="@drawable/ic_add"
                        android:contentDescription="Tambah" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Row 6: Coklat / Ceres -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Coklat Meses"
                        android:textColor="#212529"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Rp 4.000"
                        android:textColor="#757575"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btnMinusCoklat"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:src="@drawable/ic_remove"
                        android:contentDescription="Kurang" />

                    <TextView
                        android:id="@+id/tvQtyCoklat"
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#212529"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnPlusCoklat"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:src="@drawable/ic_add"
                        android:contentDescription="Tambah" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Row 7: Sambal Uleg Spesial -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sambal Uleg Super Pedas"
                        android:textColor="#212529"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Rp 4.000"
                        android:textColor="#757575"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btnMinusSambal"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:src="@drawable/ic_remove"
                        android:contentDescription="Kurang" />

                    <TextView
                        android:id="@+id/tvQtySambal"
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#212529"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnPlusSambal"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:src="@drawable/ic_add"
                        android:contentDescription="Tambah" />
                </LinearLayout>
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginVertical="10dp" />

            <!-- Kontrol Jumlah Porsi Menu Utama -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jumlah Porsi"
                        android:textColor="#1E232A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kuantitas pesanan menu ini"
                        android:textColor="#757575"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btnMinusPorsi"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:src="@drawable/ic_remove"
                        android:contentDescription="Kurang Porsi" />

                    <TextView
                        android:id="@+id/tvQtyPorsi"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#212529"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnPlusPorsi"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:src="@drawable/ic_add"
                        android:contentDescription="Tambah Porsi" />
                </LinearLayout>
            </RelativeLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp" />

    <!-- Bagian Bawah: Total Dinamis & Tombol Tambah ke Pesanan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Item Ini:"
                android:textColor="#757575"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvSheetTotalDinamis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 20.000"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetTambahPesanan"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:text="Tambah ke Pesanan"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary"
            app:cornerRadius="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="20dp" />
    </LinearLayout>

</LinearLayout>
