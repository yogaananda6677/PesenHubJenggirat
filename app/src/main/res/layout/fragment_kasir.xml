<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Kontainer Konten Utama (Header, Search, Kategori, & Katalog Menu) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 1. Header Putih Modern (Logo, Online Badge, Notif, Avatar) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:elevation="2dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Logo & Brand Header -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        app:cardCornerRadius="19dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFF3E0">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="6dp"
                            android:src="@drawable/logo_jenggirat_transparent"
                            android:contentDescription="Logo Jenggirat" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Jenggirat"
                                android:textColor="#1E232A"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <!-- Badge Online Hijau -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_badge_online"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp">

                                <View
                                    android:layout_width="6dp"
                                    android:layout_height="6dp"
                                    android:background="@drawable/bg_badge_cart"
                                    android:backgroundTint="#4CAF50" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="Online"
                                    android:textColor="#2E7D32"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sistem Pemesanan POS • Jenggirat Kediri"
                            android:textColor="#757575"
                            android:textSize="11sp"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Actions Top Right: Bell & Avatar -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/btnPosNotifikasi"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="5dp"
                        android:src="@drawable/ic_notifications"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Notifikasi" />

                    <ImageView
                        android:id="@+id/btnPosProfile"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:padding="4dp"
                        android:src="@drawable/ic_account_circle"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Profil Akun" />
                </LinearLayout>
            </RelativeLayout>

            <!-- 2. Search Bar Rounded Modern -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="Cari" />

                <EditText
                    android:id="@+id/edtCariMenuPos"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Cari menu (Martabak, Terang Bulan, ...)"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:textColor="#1E232A"
                    android:textColorHint="#94A3B8"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/btnClearSearch"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    android:contentDescription="Hapus Cari" />
            </LinearLayout>

            <!-- 3. Horizontal Filter Chips Kategori -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Chip: Semua -->
                    <TextView
                        android:id="@+id/chipKategoriSemua"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_chip_category_active"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="Semua"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Chip: Martabak Telur -->
                    <TextView
                        android:id="@+id/chipKategoriMartabak"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_category_inactive"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="Martabak Telur"
                        android:textColor="#495057"
                        android:textSize="12sp" />

                    <!-- Chip: Terang Bulan -->
                    <TextView
                        android:id="@+id/chipKategoriTerangBulan"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_category_inactive"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="Terang Bulan"
                        android:textColor="#495057"
                        android:textSize="12sp" />

                    <!-- Chip: Minuman -->
                    <TextView
                        android:id="@+id/chipKategoriMinuman"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_category_inactive"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="Minuman"
                        android:textColor="#495057"
                        android:textSize="12sp" />

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>

        <!-- 4. Daftar Katalog Menu POS (RecyclerView) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvKatalogMenuPos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="100dp" />

            <!-- Empty State jika pencarian tidak ditemukan -->
            <LinearLayout
                android:id="@+id/layoutEmptyMenuPos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_search"
                    android:alpha="0.4"
                    android:contentDescription="Tidak Ditemukan" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Menu tidak ditemukan"
                    android:textColor="#495057"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Coba gunakan kata kunci pencarian lain"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp" />
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- 5. Sticky Floating Cart Bar (Kapsul Gelap Modern di Bawah) -->
    <LinearLayout
        android:id="@+id/layoutFloatingCartBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_floating_cart"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <!-- Badge Merah Jumlah Item -->
        <TextView
            android:id="@+id/tvBadgeJumlahCart"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_badge_cart"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Info Item Terpilih & Total Harga -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLabelItemTerpilih"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 item terpilih"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvTotalHargaFloating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 20.000"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tombol Lanjut Bayar Oranye / Kuning -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFloatingLanjutBayar"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="#FFB300"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="16dp"
            android:text="Lanjut Bayar"
            android:textColor="#1E232A"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="19dp" />

    </LinearLayout>

</RelativeLayout>
