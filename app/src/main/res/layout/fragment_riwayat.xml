<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="8dp">

    <!-- Card Filter Tanggal dengan DatePickerDialog (Bab III Modul PM Pak Benni) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 Filter Riwayat Pesanan (SQLite)"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnPilihTanggal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pilih Tanggal"
                android:backgroundTint="@color/primary" />

            <Button
                android:id="@+id/btnResetTanggal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Semua"
                android:backgroundTint="#757575" />
        </LinearLayout>

        <TextView
            android:id="@+id/txFilterInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menampilkan: Semua Transaksi Tersimpan"
            android:textSize="12sp"
            android:textColor="#616161"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Ringkasan Total Pendapatan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:padding="10dp"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Transaksi:"
                android:textSize="11sp"
                android:textColor="#757575" />

            <TextView
                android:id="@+id/txCountRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Pesanan"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/black" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Pendapatan:"
                android:textSize="11sp"
                android:textColor="#757575" />

            <TextView
                android:id="@+id/txSumRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 0"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@android:color/holo_green_dark" />
        </LinearLayout>
    </LinearLayout>

    <!-- Teks bila belum ada riwayat -->
    <TextView
        android:id="@+id/txRiwayatKosong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Belum ada riwayat transaksi selesai di arsip SQLite.\nPesanan yang selesai di antrean akan otomatis tersimpan disini."
        android:textAlignment="center"
        android:textSize="13sp"
        android:textColor="#9E9E9E"
        android:padding="24dp"
        android:visibility="gone" />

    <!-- ListView Daftar Riwayat Selesai -->
    <ListView
        android:id="@+id/lsRiwayat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp" />

</LinearLayout>
