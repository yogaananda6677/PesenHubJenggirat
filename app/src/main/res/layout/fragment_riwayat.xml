<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA"
    android:padding="12dp">

    <!-- Card Filter Tanggal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_minimal"
        android:padding="14dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filter Tanggal Transaksi"
            android:textStyle="bold"
            android:textColor="#212529"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPilihTanggal"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Pilih Tanggal"
                android:textSize="12sp"
                android:textColor="@color/white"
                app:backgroundTint="@color/primary"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetTanggal"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:text="Semua"
                android:textSize="12sp"
                android:textColor="#495057"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#CED4DA"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txFilterInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menampilkan: Semua Transaksi Tersimpan"
            android:textSize="11sp"
            android:textColor="#6C757D"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Card Ringkasan Total Pendapatan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card_minimal"
        android:padding="14dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Transaksi"
                android:textSize="11sp"
                android:textColor="#6C757D" />

            <TextView
                android:id="@+id/txCountRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Pesanan"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#212529"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Omzet Selesai"
                android:textSize="11sp"
                android:textColor="#6C757D" />

            <TextView
                android:id="@+id/txSumRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 0"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#2E7D32"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Teks bila belum ada riwayat -->
    <TextView
        android:id="@+id/txRiwayatKosong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Belum ada riwayat transaksi selesai di arsip SQLite.\nPesanan yang diselesaikan di dapur akan tersimpan otomatis di sini."
        android:textAlignment="center"
        android:textSize="13sp"
        android:textColor="#6C757D"
        android:padding="32dp"
        android:visibility="gone" />

    <!-- ListView Daftar Riwayat Selesai -->
    <ListView
        android:id="@+id/lsRiwayat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp" />

</LinearLayout>
