<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card_minimal"
    android:padding="14dp"
    android:layout_marginBottom="8dp"
    android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvOrderNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#ORD-001"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvCustomerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Nama Pelanggan"
                android:textStyle="bold"
                android:textColor="#212529"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMenuDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detail menu pesanan"
            android:textColor="#495057"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MASUK"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="#C62828"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="#FFEBEE" />

            <TextView
                android:id="@+id/tvSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sumber: WEB"
                android:textColor="#6C757D"
                android:textSize="11sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tombol Opsi PopupMenu (Titik Tiga) -->
    <ImageButton
        android:id="@+id/btnOpsi"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_menu_more"
        android:focusable="false"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Opsi Status Pesanan" />

</LinearLayout>
