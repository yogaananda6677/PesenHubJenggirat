<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card_minimal"
    android:padding="10dp"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNamaItemKeranjang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Martabak Sosis/Jamur Spesial (Keju)"
            android:textStyle="bold"
            android:textColor="#212529"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvHargaSatuanKeranjang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@ Rp 35.000"
            android:textColor="#6C757D"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvSubtotalKeranjang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subtotal: Rp 35.000"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Kontrol Kuantitas: [-] [Qty] [+] -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginEnd="8dp">

        <Button
            android:id="@+id/btnMinusQty"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="-"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#212529"
            android:backgroundTint="#ECEFF1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp" />

        <TextView
            android:id="@+id/tvQtyItemKeranjang"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1"
            android:textStyle="bold"
            android:textColor="#212529"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnPlusQty"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="+"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp" />
    </LinearLayout>

    <!-- Tombol Hapus -->
    <Button
        android:id="@+id/btnHapusItemKeranjang"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="Hapus"
        android:textSize="10sp"
        android:textColor="#D32F2F"
        android:backgroundTint="#FFEBEE"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingHorizontal="8dp" />

</LinearLayout>
