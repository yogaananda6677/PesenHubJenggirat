<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card_menu"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNamaItemKeranjang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Martabak Sosis/Jamur Spesial"
            android:textStyle="bold"
            android:textColor="#1E232A"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvHargaSatuanKeranjang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@ Rp 35.000"
            android:textColor="#6C757D"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvSubtotalKeranjang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 35.000"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Kontrol Kuantitas: [-] [Qty] [+] -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginEnd="6dp">

        <ImageButton
            android:id="@+id/btnMinusQty"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_stepper_circle"
            android:src="@drawable/ic_remove"
            android:contentDescription="Kurang" />

        <TextView
            android:id="@+id/tvQtyItemKeranjang"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1"
            android:textStyle="bold"
            android:textColor="#212529"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btnPlusQty"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_stepper_circle"
            android:src="@drawable/ic_add"
            android:contentDescription="Tambah" />
    </LinearLayout>

    <!-- Tombol Hapus Icon Sampah -->
    <ImageButton
        android:id="@+id/btnHapusItemKeranjang"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="6dp"
        android:src="@drawable/ic_delete"
        android:contentDescription="Hapus Item" />

</LinearLayout>
