<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="28dp"
        android:paddingVertical="32dp">

        <ImageView
            android:id="@+id/imgLogoLogin"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@drawable/ic_logo_jenggirat"
            android:contentDescription="Logo PesenHub Jenggirat"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/txTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PesenHub Jenggirat"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Login Kasir &amp; Operator Outlet"
            android:textSize="14sp"
            android:textColor="#616161"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email / Username"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edUsername"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Masukkan email kasir"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_input_field"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Masukkan password"
            android:inputType="textPassword"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_input_field"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/cbIngatUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingat saya"
            android:textSize="14sp"
            android:textColor="#424242"
            android:buttonTint="@color/primary"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="MASUK (LOGIN)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary"
            app:cornerRadius="8dp"
            android:elevation="2dp" />

        <TextView
            android:id="@+id/txDaftarBaru"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Belum punya akun? Daftar Admin / Kasir Baru"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>
