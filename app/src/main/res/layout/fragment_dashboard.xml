<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Kartu Profil Outlet Modern -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_header_gradient"
            android:padding="18dp"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imgLogoDashboard"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/logo_jenggirat_transparent"
                    android:contentDescription="Logo Martabak Jenggirat" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PesenHub Jenggirat"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Martabak &amp; Terang Bulan — Cabang Kediri"
                        android:textColor="#F5F5F5"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#40FFFFFF"
                android:layout_marginVertical="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txKasirEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pengguna: -"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txTanggalHariIni"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hari ini: -"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txRoleBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KASIR"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_tag_role"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Judul Ringkasan Metrik -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ringkasan Operasional"
            android:textColor="#212529"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp" />

        <!-- Grid Metrik 2x2 (Baris 1) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Card 1: Pesanan Masuk -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_minimal"
                android:padding="14dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pesanan Masuk"
                    android:textSize="12sp"
                    android:textColor="#C62828"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txJumlahPending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#212529"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menunggu diproses"
                    android:textSize="11sp"
                    android:textColor="#6C757D"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Card 2: Sedang Dimasak -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_minimal"
                android:padding="14dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sedang Dimasak"
                    android:textSize="12sp"
                    android:textColor="#E65100"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txJumlahProses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#212529"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Proses dapur martabak"
                    android:textSize="11sp"
                    android:textColor="#6C757D"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Grid Metrik 2x2 (Baris 2) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <!-- Card 3: Pesanan Selesai -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_minimal"
                android:padding="14dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pesanan Selesai"
                    android:textSize="12sp"
                    android:textColor="#2E7D32"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txJumlahSelesai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#212529"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Arsip transaksi lokal"
                    android:textSize="11sp"
                    android:textColor="#6C757D"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Card 4: Total Penjualan -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_minimal"
                android:padding="14dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Penjualan"
                    android:textSize="12sp"
                    android:textColor="#1565C0"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txTotalOmzet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212529"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Omzet selesai"
                    android:textSize="11sp"
                    android:textColor="#6C757D"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Judul Menu Cepat -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menu Cepat"
            android:textColor="#212529"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAksiKasir"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Buka Kasir (Buat Pesanan)"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary"
            app:cornerRadius="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAksiAntrian"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Antrean Dapur"
                android:textColor="@color/primary"
                android:textSize="13sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/primary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="8dp"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAksiRiwayat"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Riwayat Transaksi"
                android:textColor="@color/primary"
                android:textSize="13sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/primary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="8dp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Tombol Khusus Admin -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUndangKasir"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Undang Staf Kasir Baru"
            android:textColor="#4E342E"
            android:textSize="13sp"
            android:textStyle="bold"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="#8D6E63"
            app:strokeWidth="1.5dp"
            app:cornerRadius="8dp"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKelolaMenu"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Kelola Menu &amp; Harga Multi-Channel"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="@color/primary"
            app:strokeWidth="1.5dp"
            app:cornerRadius="8dp"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

        <!-- Card Inspirasi Hari Ini (Volley) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_minimal"
            android:padding="14dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inspirasi Hari Ini"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/txKutipanVolley"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Memuat kutipan via layanan web..."
                android:textSize="12sp"
                android:textStyle="italic"
                android:textColor="#495057"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Card Status Sistem Minimalis -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_minimal"
            android:padding="14dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status Koneksi &amp; Sistem"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#495057" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Cloud Firestore: Sinkron Realtime (Koleksi 'orders' &amp; 'menus')"
                android:textSize="11sp"
                android:textColor="#6C757D"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• SQLite Database: Aktif (Arsip 'riwayat_transaksi')"
                android:textSize="11sp"
                android:textColor="#6C757D"
                android:layout_marginTop="3dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Customer Web Portal: Terhubung"
                android:textSize="11sp"
                android:textColor="#6C757D"
                android:layout_marginTop="3dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
