<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="28dp"
        android:paddingVertical="32dp">

        <ImageView
            android:id="@+id/imgLogoRegister"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/logo_jenggirat_transparent"
            android:contentDescription="Logo Martabak Jenggirat"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pendaftaran Akun"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PesenHub Jenggirat — Cabang Kediri"
            android:textSize="13sp"
            android:textColor="#616161"
            android:layout_marginBottom="24dp" />

        <!-- Pemilihan Tipe Akun: Admin vs Kasir -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih Jenis Akun:"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginBottom="6dp" />

        <RadioGroup
            android:id="@+id/rgTipeAkun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbAdmin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Admin Outlet"
                android:textSize="13sp"
                android:checked="true"
                android:buttonTint="@color/primary" />

            <RadioButton
                android:id="@+id/rbKasir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kasir (Diundang)"
                android:textSize="13sp"
                android:buttonTint="@color/primary" />
        </RadioGroup>

        <!-- Input Nama Lengkap -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama Lengkap"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edNama"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Contoh: Budi Santoso"
            android:inputType="textPersonName"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_input_field"
            android:textSize="14sp"
            android:layout_marginBottom="14dp" />

        <!-- Field Khusus Kasir: Kode Undangan Admin -->
        <LinearLayout
            android:id="@+id/layoutKasirUndangan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kode Undangan dari Admin *"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#D32F2F"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edKodeUndangan"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Masukkan kode (cth: JGR-8492)"
                android:inputType="textCapCharacters"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_input_field"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kasir wajib memiliki kode undangan aktif yang digenerate oleh Admin Outlet."
                android:textSize="11sp"
                android:textColor="#757575"
                android:layout_marginBottom="14dp" />
        </LinearLayout>

        <!-- Input Email -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edEmail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="contoh@gmail.com"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_input_field"
            android:textSize="14sp"
            android:layout_marginBottom="14dp" />

        <!-- Input Password -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password (Minimal 6 Karakter)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Masukkan password baru"
            android:inputType="textPassword"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_input_field"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- Tombol Daftar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDaftar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="DAFTAR SEBAGAI ADMIN"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary"
            app:cornerRadius="8dp"
            android:elevation="2dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:indeterminateTint="@color/primary"
            android:layout_marginTop="12dp" />

        <!-- Tombol Kembali ke Login -->
        <TextView
            android:id="@+id/txKembaliLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sudah punya akun? Masuk (Login)"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>
